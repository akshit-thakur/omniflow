# Compose namespace. Choose a unique value before first start when multiple
# checkouts share one Docker daemon; changing it later selects different volumes.
OMNIFLOW_PROJECT_NAME=omniflow
# Public single-origin bind (localhost-only by default)
OMNIFLOW_BIND_ADDRESS=127.0.0.1
OMNIFLOW_PORT=3001

# PostgreSQL. database-init reconciles Docker access/name drift and then always
# upgrades this configured database to Alembic head; no GUI or manual SQL needed.
POSTGRES_DB=omniflow
DATABASE_ADMIN_USER=omniflow_admin
# Optional. On first start, a strong value is generated into the private
# runtime-secrets volume when this is blank, weak, or still a placeholder.
# Once created, the volume's value is preserved across restarts.
POSTGRES_PASSWORD=
DATABASE_RUNTIME_USER=omniflow_api
DATABASE_RUNTIME_PASSWORD=
AI_RUNTIME_USER=omniflow_ai
AI_RUNTIME_PASSWORD=
OPERATOR_PASSWORD=
OMNIFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
# Set true only when the published origin is served over HTTPS.
OMNIFLOW_SESSION_COOKIE_SECURE=false
# Recovery hint for a pre-existing volume created with a custom superuser.
# Normally leave both blank; the migrator also tries omniflow and postgres.
DATABASE_ADMIN_USER=
DATABASE_LEGACY_SUPERUSER=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30

# Optional input for the first start. Blank/placeholder values are replaced by
# a generated credential stored only in the private runtime-secrets volume.
AI_SERVICE_SECRET=

# Local Ollama models
OLLAMA_EMBED_MODEL=bge-m3
# qwen3:8b is the default reasoner. On Docker Desktop memory allocations around
# 8 GiB, use qwen3:4b-instruct-2507-q4_K_M for reliable local demos.
OLLAMA_REASONER_MODEL=qwen3:8b
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
MODEL_PULL_ATTEMPTS=5
# Deadline for each individual pull; retries resume Ollama's partial download.
MODEL_PULL_TIMEOUT_SECONDS=3600

# Retrieval index
INDEX_VERSION=2
RETRIEVAL_LIMIT=8
MAX_SEMANTIC_DISTANCE=0.60
INDEX_SYNC_INTERVAL_SECONDS=60
AUTO_REINDEX=true
